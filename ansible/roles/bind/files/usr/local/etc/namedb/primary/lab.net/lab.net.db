$TTL  1h
@       IN      SOA     dns.lab.net. root.dns.lab.net. (
                        2026072502 ; serial (yyyymmddnn)
                        1h         ; refresh
                        15m        ; update retry
                        1w         ; expiry
                        1d         ; minimum
)

; Name server
       IN  NS  dns.lab.net.
       IN  A   10.0.0.2

; Servers
; keep-sorted start numeric=yes
bsd     IN A 10.0.0.101
dns     IN A 10.0.0.2
ldap    IN A 10.0.0.3
nuc     IN A 10.0.0.1
pkg     IN A 10.0.0.5
ssl     IN A 10.0.0.4
; keep-sorted end

; keep-sorted start
freebsd-base.pkg  IN CNAME pkg
freebsd-kmods.pkg IN CNAME pkg
freebsd-ports.pkg IN CNAME pkg
; keep-sorted end

; keep-sorted start
_https._tcp.freebsd-base.pkg.lab.net.   IN SRV 10 100 443 freebsd-base.pkg.lab.net.
_https._tcp.freebsd-kmods.pkg.lab.net.  IN SRV 10 100 443 freebsd-kmods.pkg.lab.net.
_https._tcp.freebsd-ports.pkg.lab.net.  IN SRV 10 100 443 freebsd-ports.pkg.lab.net.
; keep-sorted end
