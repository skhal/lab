worker_processes  1;

events {
  worker_connections  1024;
}

http {
  # Use absolute path includes to make Nginx configuration validator work
  # with Ansible, which runs validation `nginx -t -c %s` on a temporary file
  # and nginx(1) tries to pick up mime.types from the same location instead
  # of prefix even if `-p /usr/local/etc/nginx` is used without effect.
  #
  include       /usr/local/etc/nginx/mime.types;
  default_type  application/octet-stream;

  sendfile    on;

  keepalive_timeout  65;

  server {
    listen        {{ poudriere_web_access.addr }}:443 ssl;
    server_name   {{ inventory_hostname }};

    allow 10.0.0.0/24;  # local network
    deny  all;

    ssl_certificate     {{ poudriere_cert }};
    ssl_certificate_key {{ poudriere_cert_key }};

    access_log	/var/log/nginx/poudriere.access.log;
    error_log 	/var/log/nginx/poudriere.error.log warn;

    root /usr/local/share/poudriere/html;

    location /data {
      alias     /usr/local/poudriere/data/logs/bulk;
      autoindex on;
    }
  }
}
