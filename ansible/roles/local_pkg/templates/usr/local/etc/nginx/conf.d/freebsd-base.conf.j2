  proxy_cache_path /var/cache/pkg.freebsd-base levels=1:2 use_temp_path=off
                   keys_zone=freebsd-base:10m inactive=30d;

  server {
    listen        {{ local_pkg_listen_on }}:443 ssl;
    server_name   freebsd-base.{{ inventory_hostname }};

    allow 10.0.0.0/24;  # local network
    deny  all;

    ssl_certificate     /usr/local/etc/nginx/ssl/pkg.crt;
    ssl_certificate_key /usr/local/etc/nginx/ssl/private/pkg.key;

    access_log /var/log/nginx/freebsd-base.access.log proxy-pass;

    # keep-sorted start
    proxy_cache               freebsd-base;
    proxy_cache_bypass        $http_x_cache_bypass;
    proxy_cache_lock          on;  # concurrent MISS'es lock, first fetches.
    proxy_cache_lock_timeout  30s; # first fetch must complete in 30 seconds.
    proxy_cache_revalidate    on;  # conditional GET for outdated content.
    proxy_cache_valid         200 206 14d; # cache validity
    proxy_ssl_server_name     on;
    # keep-sorted end

    location / {
      # keep-sorted start
      proxy_cache_key   $scheme$proxy_host$request_uri;
      proxy_pass        https://pkg.FreeBSD.org;
      proxy_set_header  If-Modified-Since $http_if_modified_since;
      # keep-sorted end

      proxy_intercept_errors on;
      error_page 301 302 307 = @redirect;

      add_header X-Cache "$upstream_cache_status freebsd-base";
    }

    location @redirect {
      # keep-sorted start
      set $orig_cache_key     $scheme$proxy_host$request_uri;
      set $orig_cache_status  $upstream_cache_status;
      set $redirect_location  $upstream_http_location;
      # keep-sorted end

      resolver localhost:53 ipv6=off;

      # keep-sorted start
      proxy_cache_key   $orig_cache_key;
      proxy_pass        $redirect_location;
      proxy_set_header  If-Modified-Since $http_if_modified_since;
      # keep-sorted end

      add_header X-Cache "$orig_cache_status freebsd-base (before redirect)";
      add_header X-Cache "$upstream_cache_status freebsd-base (redirect)";
    }
  }
