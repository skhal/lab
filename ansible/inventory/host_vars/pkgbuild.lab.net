---
# keep-sorted start
ansible_jexec_over_ssh_jail_name: pkgbuild
certval_certificates:
  - name: "Poudriere Web Certificate"
    path: "/usr/local/etc/nginx/ssl/poudriere.crt"
openssl_gen_common_name: pkgbuild.lab.net
openssl_gen_crt: "/usr/local/etc/nginx/ssl/poudriere.crt"
openssl_gen_group: www
openssl_gen_owner: www
openssl_gen_rsa:
  path: /usr/local/etc/poudriere/ssl/pkg.pub
  owner: root
  group: wheel
pkg_install:
  # keep-sorted start
  - FreeBSD-zfs
  - bind-tools
  - doas
  - neovim
  # keep-sorted end
pkgbuild_jail: 151amd64
pkgbuild_overlay: lab
poudriere_abi_link:
  src: 151amd64-default
  dst: 15amd64-default
poudriere_bootstrap:
  overlay: lab
  package: ports-mgmt/bootstrap-pkg-repo
poudriere_cert: /usr/local/etc/nginx/ssl/poudriere.crt
poudriere_cert_key: /usr/local/etc/nginx/ssl/private/poudriere.key
poudriere_conf_allow_make_jobs: true
poudriere_conf_package_fetch:
  url: pkg+https://freebsd-ports.pkg.lab.net/\${ABI}
poudriere_conf_zfs_dset: zroot/usr/jail/pkgbuild/poudriere
poudriere_hook_plugins:
  ca_cert:
    CA_CERT: /usr/local/share/certs/ca.crt
poudriere_jail:
  name: 151amd64
  pkgbase_repodir: base_release_1
  pkgbase_uri: pkg+https://freebsd-base.pkg.lab.net
  version: 15
poudriere_port_trees:
  - name: lab
    repo: https://github.com/skhal/lab.git
    path: ports
poudriere_web_access:
  addr: 10.0.0.6
ssh_listen_addresses:
  - 10.0.0.6
# keep-sorted end
