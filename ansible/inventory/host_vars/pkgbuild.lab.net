---
# keep-sorted start
ansible_jexec_over_ssh_jail_name: pkgbuild
openssl_gen_rsa:
  path: /usr/local/etc/poudriere/ssl/pkg.pub
  owner: root
  group: wheel
poudriere_jail:
  name: 151amd64
  version: 15.1-RELEASE
poudriere_port_trees:
  - name: lab
    repo: https://github.com/skhal/lab.git
    path: ports
ssh_listen_addresses:
  - 10.0.0.6
# keep-sorted end
