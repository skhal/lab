# Source: /etc/pkg/FreeBSD.conf
freebsd-ports: {
  url: "pkg+http://{{ local_pkg_hostname }}/freebsd/ports/${ABI}/latest",
  mirror_type: "srv",
  signature_type: "fingerprints",
  fingerprints: "/usr/share/keys/pkg",
  enabled: yes,
  # Set priority that is higher than default repositories.
  priority: 1
}
