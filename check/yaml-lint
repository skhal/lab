# Yaml-lint runs different linters and formatter for ordinary ans Ansible YAML
# files. A YAML file is Ansible YAML if it resides in an Ansible project, i.e.
# a folder with ansible.cfg file.
set -e

# ansible_project returns longest prefix of the path that points at the Ansible
# project for a given file. It looks up to five levels up.
#
# For example, given the following project with a single role:
#   /path/to/project/
#       ansible.cfg
#       roles/foo/tasks/main.yml
#
# `ansible_project /path/to/project/roles/foo/tasks/main.yml` returns:
#   /path/to/project
ansible_project() {
  local _path=${1:?'ansible_project: missing path'}
  for _ in $(seq 1 5); do
    if [ "${_path}" = "." ]; then
      break
    fi
    _path=$(dirname "${_path}")
    if [ -e "${_path}/ansible.cfg" ]; then
      echo "${_path}"
    fi
  done
}

# check_ansible_projects runs Ansible-lint on ansible projects passed as
# arguments:
#   project=file[,file][:project=file[,file]]
#
# where project is the path to the project and file is the path to the YAML
# file, relative to the project.
#
# It eagerly runs all checks and reports an error if any of the checks failed.
check_ansible_projects() (
  # run in a sub-shell to limit IFS exposure.
  local _rc=0

  local _p _proj _files
  IFS=:
  for _p in $@; do
    _proj="${_p%%=*}"
    _files="${_p#*=}"
    if ! _check_ansible_project "$_proj" $_files; then
      _rc=1
    fi
  done

  exit $_rc
)

_check_ansible_project() (
  # run in a sub-shell to reset IFS
  unset IFS

  local _proj=${1:?'_check_ansible_project: missing project'}
  local _files=${2:?'_check_ansible_project: missing files'}
  _files=$(echo $_files | sed -e 's/,/ /g')

  if $VERBOSE; then
    echo >&2 ansible-lint: $_proj $_files
  fi

  # it is safe to exec because the function runs a sub-shell
  exec env ANSIBLE_CONFIG="${_proj}/ansible.cfg" \
    ansible-lint --project-dir "${_proj}" -f brief -qq --fix=all ${_files}
)

# check_yaml_files runs YAML lint/format for non-Ansible files.
check_yaml_files() {
  if [ $# -eq 0 ]; then
    return
  fi

  if $VERBOSE; then
    echo >&2 yamlfmt: $@
  fi

  if ! yamlfmt "$@"; then
    return 1
  fi
}

filter_with() {
  local _filter=${1:?'filter_with: missing filter function'}
  local _var=${2:?'filter_with: missing output variable'}
  local _file=${3:?'filter_with: missing filename'}

  local _path
  eval "_path=\$(${_filter} '$_file')"
  if [ -z "$_path" ]; then
    return 1
  fi

  if $VERBOSE; then
    echo >&2 "[pass] $_filter: $_path $_file"
  fi

  local _list
  eval "_list=\${${_var}}"

  local _prefix _item _suffix
  case ":${_list}" in
    *:"${_path}="*)
      # We are dealing with the following line:
      #   [...:]path=file[,file][:...]
      # where
      # - prefix is everything before path=
      # - suffix is everything after path=file[,file]...
      _prefix=":${_list}"
      _prefix="${_prefix%%:${_path}=*}"
      _prefix="${_prefix#:}"
      _prefix="${_prefix:+${_prefix}:}"

      _suffix="${_list#${_prefix}}"
      _item="${_suffix%%:*}"
      _suffix="${_suffix#${_item}}"

      _item="${_item},${_file}"
      _list="${_prefix}${_item}${_suffix}"
      ;;
    *)
      _list="${_list:+${_list}:}${_path}=${_file}"
      ;;
  esac

  eval "${_var}=\"$_list\""
}

VERBOSE=false

while getopts "v" opt; do
  case "${opt}" in
    v)
      VERBOSE=true
      export VERBOSE
      ;;
    *)
      echo >&2 "invalid flag -- $opt"
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

yaml_files=
ansible_projects=
for f; do
  if filter_with ansible_project ansible_projects "$f"; then
    continue
  fi
  yaml_files="${yaml_files:+${yaml_files} }${f}"
done

rc=0
if ! check_ansible_projects ${ansible_projects}; then
  rc=1
fi

if ! check_yaml_files ${yaml_files}; then
  rc=1
fi

exit ${rc}
