{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5-5",
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh label list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh project field-list:*)",
      "Bash(gh project list:*)",
      "Bash(gh project view:*)",
      "Bash(gh run list:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(pre-commit run:*)"
    ],
    "ask": [
      "Bash(gh api * --input*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -F *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -XDELETE*)",
      "Bash(gh api * -XPATCH*)",
      "Bash(gh api * -XPOST*)",
      "Bash(gh api * -XPUT*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)"
    ]
  }
}
